{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "blackjack-royale",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "TABLES", "class_name": "BlackjackTable" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BlackjackTable"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blackjack-royale",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "821101", "simple": { "limit": 150, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "821102", "simple": { "limit": 20, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "821103", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.15 }
}
