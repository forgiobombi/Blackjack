{
  "name": "blackjack-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:worker": "wrangler dev -c apps/worker/wrangler.jsonc --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local -c apps/worker/wrangler.jsonc",
    "db:remote": "node scripts/deploy-worker.mjs --migrations-only",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist -c apps/worker/wrangler.jsonc",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "typecheck": "tsc -p apps/worker && tsc -p apps/web",
    "format": "prettier --write .",
    "lint": "prettier --check . && npm run typecheck",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/integration.mjs",
    "test:e2e": "playwright test",
    "test:load": "node tests/load.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.13",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "miniflare": "5.20261118.0-beta",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.165.0",
    "ws": "8.21.0"
  }
}
